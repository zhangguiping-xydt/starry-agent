#!/usr/bin/env python3
"""Call the {{ framework }} {{ http_method }} interface {{ handler_symbol }} of {{ project_name }}.

This is a CALLABLE skill helper. Unlike a read-only inspection script, it invokes
a live interface and returns its answer to the agent.

Safety choices that keep this honest:
  * The endpoint and auth token are read from the environment ({{ endpoint_env }},
    {{ token_env }}). They are never hard-coded.
  * It previews by default. It only sends a request when --execute is passed and
    the endpoint is configured. With --dry-run, or with no endpoint, it prints the
    exact request it would send and touches nothing.
"""

from __future__ import annotations

import argparse
import json
import os
{% if has_path_params %}import re
{% endif %}import sys
import urllib.error
import urllib.parse
import urllib.request

ENDPOINT_ENV = "{{ endpoint_env }}"
TOKEN_ENV = "{{ token_env }}"
HTTP_METHOD = "{{ http_method }}"


def parse_bool(value: str) -> bool:
    return str(value).strip().lower() in {"1", "true", "yes", "y", "on"}


def endpoint_is_http_url(endpoint: str) -> bool:
    parsed = urllib.parse.urlparse(endpoint)
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


{% if has_path_params %}
def build_path_values(args: argparse.Namespace) -> dict:
    # Path parameters are substituted into {{ "{param}" }} placeholders in the
    # endpoint URL. They are NOT sent in the JSON body.
    values: dict = {}
{% for arg in path_args %}
    if args.{{ arg.dest }} is not None:
        values["{{ arg.wire }}"] = args.{{ arg.dest }}
{% endfor %}
    return values


def resolve_endpoint(endpoint: str, path_values: dict) -> str:
    # Replace {{ "{name}" }} and {{ "{name:converter}" }} placeholders with the
    # values provided on the command line. Missing values are left as-is so the
    # preview makes the gap visible.
    for name, value in path_values.items():
        encoded = urllib.parse.quote(str(value), safe="")
        endpoint = re.sub(r"\{" + re.escape(name) + r"(?::[^}]*)?\}", encoded, endpoint)
    return endpoint


{% endif %}
{% if has_query_params %}
def build_query_values(args: argparse.Namespace) -> dict:
    # Query parameters are appended to the endpoint URL. They are NOT sent in the
    # JSON body.
    values: dict = {}
{% for arg in query_args %}
    if args.{{ arg.dest }} is not None:
        values["{{ arg.wire }}"] = args.{{ arg.dest }}
{% endfor %}
    return values


def apply_query_params(endpoint: str, query_values: dict) -> str:
    if not query_values:
        return endpoint
    separator = "&" if "?" in endpoint else "?"
    return endpoint + separator + urllib.parse.urlencode(query_values)


{% endif %}
{% if has_body_args %}
def build_payload(args: argparse.Namespace) -> dict:
    # Body field names match the source model exactly so the JSON the interface
    # receives is correct. See references/capability-source.md. Path parameters
    # are handled separately by build_path_values().
    payload: dict = {}
{% for arg in body_args %}
    if args.{{ arg.dest }} is not None:
        payload["{{ arg.wire }}"] = args.{{ arg.dest }}
{% endfor %}
    return payload
{% else %}
def build_payload(args: argparse.Namespace) -> dict:
    # The request body could not be resolved from source (e.g. a raw dict body
    # or a GET handler); accept a raw JSON body so the capability is still
    # callable once the shape is confirmed.
    if getattr(args, "json_body", None):
        return json.loads(args.json_body)
    return {}
{% endif %}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Call the {{ handler_symbol }} capability of {{ project_name }}.",
    )
{% for arg in args %}
    {{ arg.add_argument }}
{% endfor %}
{% if not has_body_args %}
    parser.add_argument("--json-body", help="Raw JSON request body to send.")
{% endif %}
    parser.add_argument("--execute", action="store_true", help="Send the request (default is preview only).")
    parser.add_argument("--dry-run", action="store_true", help="Force preview; never send the request.")
    parser.add_argument("--timeout", type=float, default=30.0, help="HTTP timeout in seconds.")
    args = parser.parse_args(argv)

{% if has_path_params %}
    path_values = build_path_values(args)
{% endif %}
{% if has_query_params %}
    query_values = build_query_values(args)
{% endif %}
    payload = build_payload(args)
    body = json.dumps(payload, ensure_ascii=False)

    base_endpoint = os.environ.get(ENDPOINT_ENV)
{% if has_path_params %}
    endpoint = resolve_endpoint(base_endpoint or "", path_values) if base_endpoint else base_endpoint
{% else %}
    endpoint = base_endpoint
{% endif %}
{% if has_query_params %}
    endpoint = apply_query_params(endpoint or "", query_values) if endpoint else endpoint
{% endif %}
    token = os.environ.get(TOKEN_ENV)
    preview_endpoint = endpoint or "<" + ENDPOINT_ENV + ">"
{% if has_query_params %}    if not endpoint:
        preview_endpoint = apply_query_params(preview_endpoint, query_values)
{% endif %}

    # Preview unless the caller explicitly opts in AND an endpoint is configured.
    if args.dry_run or not args.execute or not endpoint:
        if args.dry_run:
            reason = "dry-run requested"
        elif not args.execute:
            reason = "--execute not set"
        else:
            reason = ENDPOINT_ENV + " not set"
        print("[preview] " + reason + "; not sending any request.")
        print("  method:   " + HTTP_METHOD)
        print("  endpoint: " + preview_endpoint)
        print("  auth:     " + ("bearer <redacted>" if token else "<" + TOKEN_ENV + " not set>"))
        print("  body:     " + body)
        return 0

    if not endpoint_is_http_url(endpoint):
        print("[error] endpoint must use http or https and include a host: " + endpoint)
        return 1

    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = "Bearer " + token
    data = body.encode("utf-8") if payload else None
    request = urllib.request.Request(endpoint, data=data, method=HTTP_METHOD, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=args.timeout) as response:
            raw = response.read().decode("utf-8")
    except urllib.error.URLError as error:
        print("[error] request to the live interface failed: " + str(error))
        return 1

    try:
        print(json.dumps(json.loads(raw), ensure_ascii=False, indent=2))
    except json.JSONDecodeError:
        print(raw)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
